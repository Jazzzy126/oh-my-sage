# oh-my-sage 网页版配置文件
# 复制为 .env 后填写，不要提交 .env。

# ==================== LLM 配置 ====================

# OpenAI 兼容接口地址和模型名称，可选服务商见 README「方式二：网页版」
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 你的 API Key，必填
LLM_API_KEY=

# 温度（可选，默认 0.2，工具调用更稳定）
# LLM_TEMPERATURE=0.2

# 接口协议（可选：openai 或 anthropic，默认 openai）
# LLM_PROVIDER=openai

# ==================== 安全配置（公网穿透推荐） ====================

# Web 访问密码（可选；公网/内网穿透暴露 3000 端口时强烈建议设置）
# WEB_ACCESS_TOKEN=

# ==================== 网关配置 ====================

# 米家中枢网关地址，必填，例如 http://192.168.0.5
GATEWAY_URL=
